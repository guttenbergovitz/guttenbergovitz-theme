{
    "name": "Guttenbergovitz",
    "type": "dark",
    "colors": {
        "editor.background": "#232326",
        "editor.foreground": "#d4be98",
        "activityBar.background": "#1d1d20",
        "activityBar.foreground": "#d4be98",
        "activityBarBadge.background": "#a96b69",
        "sideBar.background": "#1d1d20",
        "sideBar.foreground": "#d4be98",
        "editor.lineHighlightBackground": "#2a2a2d",
        "editor.selectionBackground": "#3a3a3d",
        "editor.selectionHighlightBackground": "#3a3a3d99",
        "editor.wordHighlightBackground": "#3a3a3d99",
        "editor.wordHighlightStrongBackground": "#3a3a3dcc",
        "editorCursor.foreground": "#d4be98",
        "editorWhitespace.foreground": "#3a3a3d",
        "editorIndentGuide.background1": "#2a2a2d",
        "editorIndentGuide.activeBackground1": "#3a3a3d",
        "editorLineNumber.foreground": "#7c7c7c",
        "editorLineNumber.activeForeground": "#d4be98",
        "statusBar.background": "#1d1d20",
        "statusBar.foreground": "#d4be98",
        "statusBar.debuggingBackground": "#a96b69",
        "statusBar.noFolderBackground": "#1d1d20",
        "titleBar.activeBackground": "#1d1d20",
        "titleBar.activeForeground": "#d4be98",
        "titleBar.inactiveBackground": "#1d1d20",
        "titleBar.inactiveForeground": "#7c7c7c",
        "tab.activeBackground": "#232326",
        "tab.inactiveBackground": "#1d1d20",
        "tab.activeForeground": "#d4be98",
        "tab.inactiveForeground": "#7c7c7c",
        "tab.border": "#1d1d20",
        "focusBorder": "#3a3a3d",
        "terminal.background": "#232326",
        "terminal.foreground": "#d4be98",
        "terminal.ansiBlack": "#1d1d20",
        "terminal.ansiBrightBlack": "#7c7c7c",
        "terminal.ansiRed": "#a96b69",
        "terminal.ansiBrightRed": "#a96b69",
        "terminal.ansiGreen": "#89a87d",
        "terminal.ansiBrightGreen": "#89a87d",
        "terminal.ansiYellow": "#d6b986",
        "terminal.ansiBrightYellow": "#d6b986",
        "terminal.ansiBlue": "#d79969",
        "terminal.ansiBrightBlue": "#d79969",
        "terminal.ansiMagenta": "#a96b69",
        "terminal.ansiBrightMagenta": "#a96b69",
        "terminal.ansiCyan": "#89a87d",
        "terminal.ansiBrightCyan": "#89a87d",
        "terminal.ansiWhite": "#d4be98",
        "terminal.ansiBrightWhite": "#d4be98",
        "editorWidget.background": "#1d1d20",
        "editorWidget.border": "#3a3a3d",
        "editorSuggestWidget.background": "#1d1d20",
        "editorSuggestWidget.border": "#3a3a3d",
        "editorSuggestWidget.selectedBackground": "#3a3a3d",
        "panel.background": "#1d1d20",
        "panel.border": "#3a3a3d",
        "panelTitle.activeForeground": "#d4be98",
        "panelTitle.inactiveForeground": "#7c7c7c"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#d6b986",
        "type": "#d6b986",
        "type.defaultLibrary": "#d6b986",
        "class": "#d6b986",
        "class.defaultLibrary": "#d6b986",
        "interface": "#d6b986",
        "enum": "#d6b986",
        "enumMember": "#d6b986",
        "struct": "#d6b986",
        "typeParameter": "#d6b986",
        "function": "#d79969",
        "function.defaultLibrary": "#d79969",
        "method": "#d79969",
        "method.defaultLibrary": "#d79969",
        "macro": "#89b4ac",
        "variable": "#d4be98",
        "variable.readonly": "#d6b986",
        "variable.defaultLibrary": "#b194a3",
        "parameter": "#d4be98",
        "property": "#d4be98",
        "property.readonly": "#d6b986",
        "keyword": "#a96b69",
        "modifier": "#a96b69",
        "comment": { "foreground": "#7c7c7c", "fontStyle": "italic" },
        "string": "#89a87d",
        "number": "#d6b986",
        "regexp": "#89b4ac",
        "operator": "#a96b69",
        "decorator": "#b194a3",
        "attribute": "#b194a3",
        "lifetime": "#b194a3",
        "label": "#d6b986",
        "selfKeyword": "#a96b69",
        "selfTypeKeyword": "#d6b986",
        "builtinType": "#d6b986",
        "formatSpecifier": "#89b4ac",
        "escapeSequence": "#d79969",
        "boolean": "#d6b986",
        "*.mutable": { "fontStyle": "underline" },
        "*.static": { "fontStyle": "bold" },
        "*.async": { "fontStyle": "italic" },
        "tomlArrayKey": "#a96b69",
        "tomlTableKey": "#a96b69"
    },
    "tokenColors": [
        {
            "name": "Keywords and Storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.expression",
                "keyword.operator.new",
                "keyword.operator.wordlike",
                "keyword.other.unit"
            ],
            "settings": {
                "foreground": "#a96b69"
            }
        },
        {
            "name": "Function declarations and calls",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic",
                "meta.function-call",
                "meta.method-call",
                "meta.function",
                "support.function.console",
                "entity.name.function.method"
            ],
            "settings": {
                "foreground": "#d79969"
            }
        },
        {
            "name": "Strings and Constants",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.regexp",
                "constant.character",
                "constant.other.character",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#89a87d"
            }
        },
        {
            "name": "Variables and Parameters",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "variable.language",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.property",
                "support.variable"
            ],
            "settings": {
                "foreground": "#d4be98"
            }
        },
        {
            "name": "Types and Classes",
            "scope": [
                "entity.name.type",
                "support.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class",
                "storage.type.built-in",
                "storage.type.primitive",
                "entity.name.type.go",
                "storage.type.go"
            ],
            "settings": {
                "foreground": "#d6b986"
            }
        },
        {
            "name": "Properties and Members",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key",
                "support.variable.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#d4be98"
            }
        },
        {
            "name": "Python language variables",
            "scope": [
                "variable.language.python"
            ],
            "settings": {
                "foreground": "#a96b69"
            }
        },
        {
            "name": "Constants and Numerics",
            "scope": [
                "constant",
                "constant.numeric",
                "constant.language",
                "constant.other",
                "support.constant"
            ],
            "settings": {
                "foreground": "#d6b986"
            }
        },
        {
            "name": "Language-specific constants",
            "scope": [
                "constant.language.python",
                "constant.language.go"
            ],
            "settings": {
                "foreground": "#b194a3"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.assignment",
                "keyword.operator.type"
            ],
            "settings": {
                "foreground": "#a96b69"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#d4be98"
            }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#7c7c7c",
                "fontStyle": "italic"
            }
        },
        {
            "name": "HTML/XML Tags",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#a96b69"
            }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#d6b986"
            }
        },
        {
            "name": "Markup Headings",
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#d79969",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup Links",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#89a87d"
            }
        },
        {
            "name": "Rust lifetimes and attributes",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.lifetime.rust",
                "meta.attribute.rust",
                "punctuation.definition.attribute.rust"
            ],
            "settings": {
                "foreground": "#b194a3"
            }
        },
        {
            "name": "Rust macros",
            "scope": [
                "entity.name.function.macro.rust",
                "support.macro.rust",
                "meta.macro.rust"
            ],
            "settings": {
                "foreground": "#89b4ac"
            }
        },
        {
            "name": "Ruby symbols and instance variables",
            "scope": [
                "constant.other.symbol.ruby",
                "variable.other.readwrite.instance.ruby",
                "variable.other.readwrite.class.ruby"
            ],
            "settings": {
                "foreground": "#89b4ac"
            }
        },
        {
            "name": "Ruby special methods",
            "scope": [
                "keyword.control.pseudo-method.ruby",
                "keyword.other.special-method.ruby"
            ],
            "settings": {
                "foreground": "#d79969"
            }
        },
        {
            "name": "PHP variables",
            "scope": [
                "variable.other.php",
                "punctuation.definition.variable.php"
            ],
            "settings": {
                "foreground": "#d4be98"
            }
        },
        {
            "name": "PHP namespaces and use",
            "scope": [
                "support.other.namespace.php",
                "entity.name.type.namespace.php",
                "support.other.namespace.use.php"
            ],
            "settings": {
                "foreground": "#d6b986"
            }
        },
        {
            "name": "Java annotations",
            "scope": [
                "storage.type.annotation.java",
                "punctuation.definition.annotation.java",
                "meta.declaration.annotation.java"
            ],
            "settings": {
                "foreground": "#b194a3"
            }
        },
        {
            "name": "Java packages",
            "scope": [
                "storage.modifier.package.java",
                "storage.modifier.import.java"
            ],
            "settings": {
                "foreground": "#7c7c7c",
                "fontStyle": "italic"
            }
        },
        {
            "name": "C# attributes and namespaces",
            "scope": [
                "entity.name.type.attribute.cs",
                "entity.name.type.namespace.cs"
            ],
            "settings": {
                "foreground": "#b194a3"
            }
        },
        {
            "name": "C# preprocessor",
            "scope": [
                "meta.preprocessor.cs",
                "punctuation.separator.hash.cs"
            ],
            "settings": {
                "foreground": "#7c7c7c"
            }
        },
        {
            "name": "TypeScript decorators",
            "scope": [
                "meta.decorator.ts",
                "punctuation.decorator.ts",
                "meta.decorator.tsx"
            ],
            "settings": {
                "foreground": "#b194a3"
            }
        },
        {
            "name": "TypeScript type assertions",
            "scope": [
                "meta.type.cast.expr.ts",
                "meta.type.annotation.ts",
                "entity.name.type.ts",
                "entity.name.type.tsx"
            ],
            "settings": {
                "foreground": "#d6b986"
            }
        },
        {
            "name": "Lua tables and metatables",
            "scope": [
                "constant.language.lua",
                "support.function.lua"
            ],
            "settings": {
                "foreground": "#b194a3"
            }
        },
        {
            "name": "Shell variables and expansions",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.positional.shell",
                "variable.other.special.shell",
                "punctuation.definition.variable.shell"
            ],
            "settings": {
                "foreground": "#89b4ac"
            }
        },
        {
            "name": "Shell builtins",
            "scope": [
                "support.function.builtin.shell"
            ],
            "settings": {
                "foreground": "#d79969"
            }
        },
        {
            "name": "YAML keys",
            "scope": [
                "entity.name.tag.yaml",
                "punctuation.definition.block.sequence.item.yaml"
            ],
            "settings": {
                "foreground": "#a96b69"
            }
        },
        {
            "name": "JSON keys",
            "scope": [
                "support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#a96b69"
            }
        },
        {
            "name": "TOML keys and tables",
            "scope": [
                "entity.name.tag.toml",
                "entity.name.section.toml",
                "support.type.property-name.toml"
            ],
            "settings": {
                "foreground": "#a96b69"
            }
        },
        {
            "name": "Regex patterns",
            "scope": [
                "string.regexp",
                "constant.other.character-class.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": {
                "foreground": "#89b4ac"
            }
        },
        {
            "name": "CSS selectors and properties",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "support.type.property-name.css"
            ],
            "settings": {
                "foreground": "#d6b986"
            }
        },
        {
            "name": "CSS values",
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css",
                "keyword.other.unit.css"
            ],
            "settings": {
                "foreground": "#89a87d"
            }
        }
    ]
}