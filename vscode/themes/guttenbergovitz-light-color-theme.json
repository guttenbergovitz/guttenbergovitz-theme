{
    "name": "Guttenbergovitz Light",
    "type": "light",
    "colors": {
        "editor.background": "#f5f3f0",
        "editor.foreground": "#5a4a3a",
        "activityBar.background": "#eae8e5",
        "activityBar.foreground": "#5a4a3a",
        "activityBarBadge.background": "#8b4c4a",
        "sideBar.background": "#eae8e5",
        "sideBar.foreground": "#5a4a3a",
        "editor.lineHighlightBackground": "#e8e6e3",
        "editor.selectionBackground": "#e8e6e3",
        "editor.selectionHighlightBackground": "#e8e6e399",
        "editor.wordHighlightBackground": "#e8e6e399",
        "editor.wordHighlightStrongBackground": "#e8e6e3cc",
        "editorCursor.foreground": "#5a4a3a",
        "editorWhitespace.foreground": "#d8d6d3",
        "editorIndentGuide.background1": "#e8e6e3",
        "editorIndentGuide.activeBackground1": "#d8d6d3",
        "editorLineNumber.foreground": "#a19f9e",
        "editorLineNumber.activeForeground": "#5a4a3a",
        "statusBar.background": "#eae8e5",
        "statusBar.foreground": "#5a4a3a",
        "statusBar.debuggingBackground": "#8b4c4a",
        "statusBar.noFolderBackground": "#eae8e5",
        "titleBar.activeBackground": "#eae8e5",
        "titleBar.activeForeground": "#5a4a3a",
        "titleBar.inactiveBackground": "#eae8e5",
        "titleBar.inactiveForeground": "#a19f9e",
        "tab.activeBackground": "#f5f3f0",
        "tab.inactiveBackground": "#eae8e5",
        "tab.activeForeground": "#5a4a3a",
        "tab.inactiveForeground": "#a19f9e",
        "tab.border": "#eae8e5",
        "focusBorder": "#d8d6d3",
        "terminal.background": "#f5f3f0",
        "terminal.foreground": "#5a4a3a",
        "terminal.ansiBlack": "#3a2a1a",
        "terminal.ansiBrightBlack": "#5a4a3a",
        "terminal.ansiRed": "#8b4c4a",
        "terminal.ansiBrightRed": "#cc6666",
        "terminal.ansiGreen": "#6b8860",
        "terminal.ansiBrightGreen": "#8ba168",
        "terminal.ansiYellow": "#b8995a",
        "terminal.ansiBrightYellow": "#d6b986",
        "terminal.ansiBlue": "#5e7ea5",
        "terminal.ansiBrightBlue": "#81a2be",
        "terminal.ansiMagenta": "#956d7e",
        "terminal.ansiBrightMagenta": "#b294bb",
        "terminal.ansiCyan": "#6b958f",
        "terminal.ansiBrightCyan": "#8abeb7",
        "terminal.ansiWhite": "#7a6a5a",
        "terminal.ansiBrightWhite": "#f5f3f0",
        "editorWidget.background": "#eae8e5",
        "editorWidget.border": "#d8d6d3",
        "editorSuggestWidget.background": "#eae8e5",
        "editorSuggestWidget.border": "#d8d6d3",
        "editorSuggestWidget.selectedBackground": "#e8e6e3",
        "panel.background": "#eae8e5",
        "panel.border": "#d8d6d3",
        "panelTitle.activeForeground": "#5a4a3a",
        "panelTitle.inactiveForeground": "#a19f9e"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#b8995a",
        "type": "#b8995a",
        "type.defaultLibrary": "#b8995a",
        "class": "#b8995a",
        "class.defaultLibrary": "#b8995a",
        "interface": "#b8995a",
        "enum": "#b8995a",
        "enumMember": "#b8995a",
        "struct": "#b8995a",
        "typeParameter": "#b8995a",
        "function": "#b8784c",
        "function.defaultLibrary": "#b8784c",
        "method": "#b8784c",
        "method.defaultLibrary": "#b8784c",
        "macro": "#6b958f",
        "variable": "#5a4a3a",
        "variable.readonly": "#b8995a",
        "variable.defaultLibrary": "#956d7e",
        "parameter": "#5a4a3a",
        "property": "#5a4a3a",
        "property.readonly": "#b8995a",
        "keyword": "#8b4c4a",
        "modifier": "#8b4c4a",
        "comment": { "foreground": "#a19f9e", "fontStyle": "italic" },
        "string": "#6b8860",
        "number": "#b8995a",
        "regexp": "#6b958f",
        "operator": "#8b4c4a",
        "decorator": "#956d7e",
        "attribute": "#956d7e",
        "lifetime": "#956d7e",
        "label": "#b8995a",
        "selfKeyword": "#8b4c4a",
        "selfTypeKeyword": "#b8995a",
        "builtinType": "#b8995a",
        "formatSpecifier": "#6b958f",
        "escapeSequence": "#b8784c",
        "boolean": "#b8995a",
        "*.mutable": { "fontStyle": "underline" },
        "*.static": { "fontStyle": "bold" },
        "*.async": { "fontStyle": "italic" },
        "tomlArrayKey": "#8b4c4a",
        "tomlTableKey": "#8b4c4a"
    },
    "tokenColors": [
        {
            "name": "Keywords and Storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.expression",
                "keyword.operator.new",
                "keyword.operator.wordlike",
                "keyword.other.unit"
            ],
            "settings": {
                "foreground": "#8b4c4a"
            }
        },
        {
            "name": "Function declarations and calls",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic",
                "meta.function-call",
                "meta.method-call",
                "meta.function",
                "support.function.console",
                "entity.name.function.method"
            ],
            "settings": {
                "foreground": "#b8784c"
            }
        },
        {
            "name": "Strings and Constants",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.regexp",
                "constant.character",
                "constant.other.character",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#6b8860"
            }
        },
        {
            "name": "Variables and Parameters",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "variable.language",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.property",
                "support.variable"
            ],
            "settings": {
                "foreground": "#5a4a3a"
            }
        },
        {
            "name": "Types and Classes",
            "scope": [
                "entity.name.type",
                "support.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class",
                "storage.type.built-in",
                "storage.type.primitive",
                "entity.name.type.go",
                "storage.type.go"
            ],
            "settings": {
                "foreground": "#b8995a"
            }
        },
        {
            "name": "Properties and Members",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key",
                "support.variable.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#5a4a3a"
            }
        },
        {
            "name": "Python language variables",
            "scope": [
                "variable.language.python"
            ],
            "settings": {
                "foreground": "#8b4c4a"
            }
        },
        {
            "name": "Constants and Numerics",
            "scope": [
                "constant",
                "constant.numeric",
                "constant.language",
                "constant.other",
                "support.constant"
            ],
            "settings": {
                "foreground": "#b8995a"
            }
        },
        {
            "name": "Language-specific constants",
            "scope": [
                "constant.language.python",
                "constant.language.go"
            ],
            "settings": {
                "foreground": "#956d7e"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.assignment",
                "keyword.operator.type"
            ],
            "settings": {
                "foreground": "#8b4c4a"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#5a4a3a"
            }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#a19f9e",
                "fontStyle": "italic"
            }
        },
        {
            "name": "HTML/XML Tags",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#8b4c4a"
            }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#b8995a"
            }
        },
        {
            "name": "Markup Headings",
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#b8784c",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup Links",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#6b8860"
            }
        },
        {
            "name": "Rust lifetimes and attributes",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.lifetime.rust",
                "meta.attribute.rust",
                "punctuation.definition.attribute.rust"
            ],
            "settings": {
                "foreground": "#956d7e"
            }
        },
        {
            "name": "Rust macros",
            "scope": [
                "entity.name.function.macro.rust",
                "support.macro.rust",
                "meta.macro.rust"
            ],
            "settings": {
                "foreground": "#6b958f"
            }
        },
        {
            "name": "Ruby symbols and instance variables",
            "scope": [
                "constant.other.symbol.ruby",
                "variable.other.readwrite.instance.ruby",
                "variable.other.readwrite.class.ruby"
            ],
            "settings": {
                "foreground": "#6b958f"
            }
        },
        {
            "name": "Ruby special methods",
            "scope": [
                "keyword.control.pseudo-method.ruby",
                "keyword.other.special-method.ruby"
            ],
            "settings": {
                "foreground": "#b8784c"
            }
        },
        {
            "name": "PHP variables",
            "scope": [
                "variable.other.php",
                "punctuation.definition.variable.php"
            ],
            "settings": {
                "foreground": "#5a4a3a"
            }
        },
        {
            "name": "PHP namespaces and use",
            "scope": [
                "support.other.namespace.php",
                "entity.name.type.namespace.php",
                "support.other.namespace.use.php"
            ],
            "settings": {
                "foreground": "#b8995a"
            }
        },
        {
            "name": "Java annotations",
            "scope": [
                "storage.type.annotation.java",
                "punctuation.definition.annotation.java",
                "meta.declaration.annotation.java"
            ],
            "settings": {
                "foreground": "#956d7e"
            }
        },
        {
            "name": "Java packages",
            "scope": [
                "storage.modifier.package.java",
                "storage.modifier.import.java"
            ],
            "settings": {
                "foreground": "#a19f9e",
                "fontStyle": "italic"
            }
        },
        {
            "name": "C# attributes and namespaces",
            "scope": [
                "entity.name.type.attribute.cs",
                "entity.name.type.namespace.cs"
            ],
            "settings": {
                "foreground": "#956d7e"
            }
        },
        {
            "name": "C# preprocessor",
            "scope": [
                "meta.preprocessor.cs",
                "punctuation.separator.hash.cs"
            ],
            "settings": {
                "foreground": "#a19f9e"
            }
        },
        {
            "name": "TypeScript decorators",
            "scope": [
                "meta.decorator.ts",
                "punctuation.decorator.ts",
                "meta.decorator.tsx"
            ],
            "settings": {
                "foreground": "#956d7e"
            }
        },
        {
            "name": "TypeScript type assertions",
            "scope": [
                "meta.type.cast.expr.ts",
                "meta.type.annotation.ts",
                "entity.name.type.ts",
                "entity.name.type.tsx"
            ],
            "settings": {
                "foreground": "#b8995a"
            }
        },
        {
            "name": "Lua tables and metatables",
            "scope": [
                "constant.language.lua",
                "support.function.lua"
            ],
            "settings": {
                "foreground": "#956d7e"
            }
        },
        {
            "name": "Shell variables and expansions",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.positional.shell",
                "variable.other.special.shell",
                "punctuation.definition.variable.shell"
            ],
            "settings": {
                "foreground": "#6b958f"
            }
        },
        {
            "name": "Shell builtins",
            "scope": [
                "support.function.builtin.shell"
            ],
            "settings": {
                "foreground": "#b8784c"
            }
        },
        {
            "name": "YAML keys",
            "scope": [
                "entity.name.tag.yaml",
                "punctuation.definition.block.sequence.item.yaml"
            ],
            "settings": {
                "foreground": "#8b4c4a"
            }
        },
        {
            "name": "JSON keys",
            "scope": [
                "support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#8b4c4a"
            }
        },
        {
            "name": "TOML keys and tables",
            "scope": [
                "entity.name.tag.toml",
                "entity.name.section.toml",
                "support.type.property-name.toml"
            ],
            "settings": {
                "foreground": "#8b4c4a"
            }
        },
        {
            "name": "Regex patterns",
            "scope": [
                "string.regexp",
                "constant.other.character-class.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": {
                "foreground": "#6b958f"
            }
        },
        {
            "name": "CSS selectors and properties",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "support.type.property-name.css"
            ],
            "settings": {
                "foreground": "#b8995a"
            }
        },
        {
            "name": "CSS values",
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css",
                "keyword.other.unit.css"
            ],
            "settings": {
                "foreground": "#6b8860"
            }
        }
    ]
}