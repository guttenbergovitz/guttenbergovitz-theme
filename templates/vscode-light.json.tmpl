{
    "name": "Guttenbergovitz Light",
    "type": "light",
    "colors": {
        "editor.background": "{{base.bg}}",
        "editor.foreground": "{{semantic.punctuation}}",
        "activityBar.background": "{{base.bg_dark}}",
        "activityBar.foreground": "{{semantic.punctuation}}",
        "activityBarBadge.background": "{{git.deleted}}",
        "sideBar.background": "{{base.bg_dark}}",
        "sideBar.foreground": "{{semantic.punctuation}}",
        "editor.lineHighlightBackground": "{{ui.selection}}",
        "editor.selectionBackground": "{{ui.selection}}",
        "editor.selectionHighlightBackground": "{{ui.selection}}99",
        "editor.wordHighlightBackground": "{{ui.selection}}99",
        "editor.wordHighlightStrongBackground": "{{ui.selection}}cc",
        "editorCursor.foreground": "{{semantic.punctuation}}",
        "editorWhitespace.foreground": "{{ui.whitespace}}",
        "editorIndentGuide.background1": "{{ui.selection}}",
        "editorIndentGuide.activeBackground1": "{{ui.whitespace}}",
        "editorLineNumber.foreground": "{{git.untracked}}",
        "editorLineNumber.activeForeground": "{{semantic.punctuation}}",
        "statusBar.background": "{{base.bg_dark}}",
        "statusBar.foreground": "{{semantic.punctuation}}",
        "statusBar.debuggingBackground": "{{git.deleted}}",
        "statusBar.noFolderBackground": "{{base.bg_dark}}",
        "titleBar.activeBackground": "{{base.bg_dark}}",
        "titleBar.activeForeground": "{{semantic.punctuation}}",
        "titleBar.inactiveBackground": "{{base.bg_dark}}",
        "titleBar.inactiveForeground": "{{git.untracked}}",
        "tab.activeBackground": "{{base.bg}}",
        "tab.inactiveBackground": "{{base.bg_dark}}",
        "tab.activeForeground": "{{semantic.punctuation}}",
        "tab.inactiveForeground": "{{git.untracked}}",
        "tab.border": "{{base.bg_dark}}",
        "focusBorder": "{{ui.whitespace}}",
        "terminal.background": "{{base.bg}}",
        "terminal.foreground": "{{semantic.punctuation}}",
        "terminal.ansiBlack": "{{base.fg_light}}",
        "terminal.ansiBrightBlack": "{{semantic.punctuation}}",
        "terminal.ansiRed": "{{git.deleted}}",
        "terminal.ansiBrightRed": "{{git.conflict}}",
        "terminal.ansiGreen": "{{git.added}}",
        "terminal.ansiBrightGreen": "#8ba168",
        "terminal.ansiYellow": "{{git.modified}}",
        "terminal.ansiBrightYellow": "#d6b986",
        "terminal.ansiBlue": "{{status.info}}",
        "terminal.ansiBrightBlue": "#81a2be",
        "terminal.ansiMagenta": "{{accents.purple}}",
        "terminal.ansiBrightMagenta": "#b294bb",
        "terminal.ansiCyan": "{{status.hint}}",
        "terminal.ansiBrightCyan": "#8abeb7",
        "terminal.ansiWhite": "{{base.fg_dark}}",
        "terminal.ansiBrightWhite": "{{base.bg}}",
        "editorWidget.background": "{{base.bg_dark}}",
        "editorWidget.border": "{{ui.whitespace}}",
        "editorSuggestWidget.background": "{{base.bg_dark}}",
        "editorSuggestWidget.border": "{{ui.whitespace}}",
        "editorSuggestWidget.selectedBackground": "{{ui.selection}}",
        "panel.background": "{{base.bg_dark}}",
        "panel.border": "{{ui.whitespace}}",
        "panelTitle.activeForeground": "{{semantic.punctuation}}",
        "panelTitle.inactiveForeground": "{{git.untracked}}"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "{{semantic.type}}",
        "type": "{{semantic.type}}",
        "type.defaultLibrary": "{{semantic.type}}",
        "class": "{{semantic.type}}",
        "class.defaultLibrary": "{{semantic.type}}",
        "interface": "{{semantic.type}}",
        "enum": "{{semantic.type}}",
        "enumMember": "{{semantic.type}}",
        "struct": "{{semantic.type}}",
        "typeParameter": "{{semantic.type}}",
        "function": "{{semantic.function}}",
        "function.defaultLibrary": "{{semantic.function}}",
        "method": "{{semantic.function}}",
        "method.defaultLibrary": "{{semantic.function}}",
        "macro": "{{accents.cyan}}",
        "variable": "{{base.fg}}",
        "variable.readonly": "{{semantic.type}}",
        "variable.defaultLibrary": "{{accents.purple}}",
        "parameter": "{{base.fg}}",
        "property": "{{base.fg}}",
        "property.readonly": "{{semantic.type}}",
        "keyword": "{{semantic.keyword}}",
        "modifier": "{{semantic.keyword}}",
        "comment": {
            "foreground": "{{semantic.comment}}",
            "fontStyle": "italic"
        },
        "string": "{{semantic.string}}",
        "number": "{{semantic.type}}",
        "regexp": "{{accents.cyan}}",
        "operator": "{{semantic.keyword}}",
        "decorator": "{{accents.purple}}",
        "attribute": "{{accents.purple}}",
        "lifetime": "{{accents.purple}}",
        "label": "{{semantic.type}}",
        "selfKeyword": "{{semantic.keyword}}",
        "selfTypeKeyword": "{{semantic.type}}",
        "builtinType": "{{semantic.type}}",
        "formatSpecifier": "{{accents.cyan}}",
        "escapeSequence": "{{semantic.function}}",
        "boolean": "{{semantic.boolean}}",
        "*.mutable": {
            "fontStyle": "underline"
        },
        "*.static": {
            "fontStyle": "bold"
        },
        "tomlArrayKey": "{{semantic.keyword}}",
        "tomlTableKey": "{{semantic.keyword}}"
    },
    "tokenColors": [
        {
            "name": "Keywords and Storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.expression",
                "keyword.operator.new",
                "keyword.operator.wordlike",
                "keyword.other.unit"
            ],
            "settings": {
                "foreground": "{{git.deleted}}"
            }
        },
        {
            "name": "Function declarations and calls",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic",
                "meta.function-call",
                "meta.method-call",
                "meta.function",
                "support.function.console",
                "entity.name.function.method"
            ],
            "settings": {
                "foreground": "{{git.renamed}}"
            }
        },
        {
            "name": "Strings and Constants",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.regexp",
                "constant.character",
                "constant.other.character",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "{{git.added}}"
            }
        },
        {
            "name": "Variables and Parameters",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "variable.language",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.property",
                "support.variable"
            ],
            "settings": {
                "foreground": "{{semantic.punctuation}}"
            }
        },
        {
            "name": "Types and Classes",
            "scope": [
                "entity.name.type",
                "support.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class",
                "storage.type.built-in",
                "storage.type.primitive",
                "entity.name.type.go",
                "storage.type.go"
            ],
            "settings": {
                "foreground": "{{semantic.type}}"
            }
        },
        {
            "name": "Properties and Members",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key",
                "support.variable.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "{{semantic.punctuation}}"
            }
        },
        {
            "name": "Python language variables",
            "scope": [
                "variable.language.python"
            ],
            "settings": {
                "foreground": "{{semantic.keyword}}"
            }
        },
        {
            "name": "Constants and Numerics",
            "scope": [
                "constant",
                "constant.numeric",
                "constant.language",
                "constant.other",
                "support.constant"
            ],
            "settings": {
                "foreground": "{{git.modified}}"
            }
        },
        {
            "name": "Language-specific constants",
            "scope": [
                "constant.language.python",
                "constant.language.go"
            ],
            "settings": {
                "foreground": "{{accents.purple}}"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.assignment",
                "keyword.operator.type"
            ],
            "settings": {
                "foreground": "{{git.deleted}}"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": {
                "foreground": "{{semantic.punctuation}}"
            }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "punctuation.definition.comment",
                "string.quoted.docstring",
                "string.quoted.docstring.multi"
            ],
            "settings": {
                "foreground": "{{semantic.comment}}",
                "fontStyle": "italic"
            }
        },
        {
            "name": "HTML/XML Tags",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "{{git.deleted}}"
            }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "{{git.modified}}"
            }
        },
        {
            "name": "Markup Headings",
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "{{git.renamed}}",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup Links",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "{{git.added}}"
            }
        },
        {
            "name": "Rust lifetimes and attributes",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.lifetime.rust",
                "meta.attribute.rust",
                "punctuation.definition.attribute.rust"
            ],
            "settings": {
                "foreground": "{{accents.purple}}"
            }
        },
        {
            "name": "Rust macros",
            "scope": [
                "entity.name.function.macro.rust",
                "support.macro.rust",
                "meta.macro.rust"
            ],
            "settings": {
                "foreground": "{{accents.cyan}}"
            }
        },
        {
            "name": "Ruby symbols and instance variables",
            "scope": [
                "constant.other.symbol.ruby",
                "variable.other.readwrite.instance.ruby",
                "variable.other.readwrite.class.ruby"
            ],
            "settings": {
                "foreground": "{{accents.cyan}}"
            }
        },
        {
            "name": "Ruby special methods",
            "scope": [
                "keyword.control.pseudo-method.ruby",
                "keyword.other.special-method.ruby"
            ],
            "settings": {
                "foreground": "{{semantic.function}}"
            }
        },
        {
            "name": "PHP variables",
            "scope": [
                "variable.other.php",
                "punctuation.definition.variable.php"
            ],
            "settings": {
                "foreground": "{{base.fg}}"
            }
        },
        {
            "name": "PHP namespaces and use",
            "scope": [
                "support.other.namespace.php",
                "entity.name.type.namespace.php",
                "support.other.namespace.use.php"
            ],
            "settings": {
                "foreground": "{{semantic.type}}"
            }
        },
        {
            "name": "Java annotations",
            "scope": [
                "storage.type.annotation.java",
                "punctuation.definition.annotation.java",
                "meta.declaration.annotation.java"
            ],
            "settings": {
                "foreground": "{{accents.purple}}"
            }
        },
        {
            "name": "Java packages",
            "scope": [
                "storage.modifier.package.java",
                "storage.modifier.import.java"
            ],
            "settings": {
                "foreground": "{{base.fg_dim}}"
            }
        },
        {
            "name": "C# attributes and namespaces",
            "scope": [
                "entity.name.type.attribute.cs",
                "entity.name.type.namespace.cs"
            ],
            "settings": {
                "foreground": "{{accents.purple}}"
            }
        },
        {
            "name": "C# preprocessor",
            "scope": [
                "meta.preprocessor.cs",
                "punctuation.separator.hash.cs"
            ],
            "settings": {
                "foreground": "{{base.fg_dim}}"
            }
        },
        {
            "name": "TypeScript decorators",
            "scope": [
                "meta.decorator.ts",
                "punctuation.decorator.ts",
                "meta.decorator.tsx"
            ],
            "settings": {
                "foreground": "{{accents.purple}}"
            }
        },
        {
            "name": "TypeScript type assertions",
            "scope": [
                "meta.type.cast.expr.ts",
                "meta.type.annotation.ts",
                "entity.name.type.ts",
                "entity.name.type.tsx"
            ],
            "settings": {
                "foreground": "{{semantic.type}}"
            }
        },
        {
            "name": "Lua tables and metatables",
            "scope": [
                "constant.language.lua",
                "support.function.lua"
            ],
            "settings": {
                "foreground": "{{accents.purple}}"
            }
        },
        {
            "name": "Shell variables and expansions",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.positional.shell",
                "variable.other.special.shell",
                "punctuation.definition.variable.shell"
            ],
            "settings": {
                "foreground": "{{accents.cyan}}"
            }
        },
        {
            "name": "Shell builtins",
            "scope": [
                "support.function.builtin.shell"
            ],
            "settings": {
                "foreground": "{{semantic.function}}"
            }
        },
        {
            "name": "YAML keys",
            "scope": [
                "entity.name.tag.yaml",
                "punctuation.definition.block.sequence.item.yaml"
            ],
            "settings": {
                "foreground": "{{semantic.keyword}}"
            }
        },
        {
            "name": "JSON keys",
            "scope": [
                "support.type.property-name.json"
            ],
            "settings": {
                "foreground": "{{semantic.keyword}}"
            }
        },
        {
            "name": "TOML keys and tables",
            "scope": [
                "entity.name.tag.toml",
                "entity.name.section.toml",
                "support.type.property-name.toml"
            ],
            "settings": {
                "foreground": "{{semantic.keyword}}"
            }
        },
        {
            "name": "Regex patterns",
            "scope": [
                "string.regexp",
                "constant.other.character-class.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": {
                "foreground": "{{accents.cyan}}"
            }
        },
        {
            "name": "CSS selectors and properties",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "support.type.property-name.css"
            ],
            "settings": {
                "foreground": "{{semantic.type}}"
            }
        },
        {
            "name": "CSS values",
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css",
                "keyword.other.unit.css"
            ],
            "settings": {
                "foreground": "{{semantic.string}}"
            }
        }
    ]
}
